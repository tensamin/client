{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tensamin",
  "version": "0.0.0",
  "mainBinaryName": "tensamin",
  "identifier": "net.tensamin.client",
  "build": {
    "beforeDevCommand": "cd ../web && pnpm run dev && cd ../tauri",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../.. && pnpm run build:web && cd apps/tauri",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "decorations": false,
        "title": "Tensamin",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "android": {
      "debugApplicationIdSuffix": ""
    },
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["tensamin"],
          "appLink": false
        }
      ]
    }
  }
}
